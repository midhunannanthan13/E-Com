# ===== ShopSphere backend settings =====
# 1) Copy this file to a new file named exactly:  .env   (same folder)
# 2) Replace every  <...>  with your real value
# 3) NEVER commit or share the .env file (it holds secrets)

# ---- Google login (Google Cloud Console -> your OAuth client) ----
GOOGLE_CLIENT_ID=<your-client-id>.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=<your-client-secret>
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/auth/google/callback/
FRONTEND_URL=http://localhost:3000

# =====================================================================
# PHASE A (run on your own computer): leave everything below as it is.
# The shop then uses your local MySQL (MySQL Workbench / WAMP,
# user root, localhost:3306) exactly as already set in settings.py.
#
# PHASE B (move to Aiven cloud): remove the "# " at the start of the
# lines below and fill in the values from the Aiven Console.
# =====================================================================
# AIVEN_DB_HOST=<your-service>.aivencloud.com
# AIVEN_DB_PORT=<port-shown-in-aiven>
# AIVEN_DB_PASSWORD=<your-aiven-password>
# AIVEN_DB_USER=avnadmin
# AIVEN_DB_NAME=defaultdb
# AIVEN_DB_CA_PATH=certs/ca.pem
#
# =====================================================================
# PRODUCTION HOSTING (e.g. Render / Railway):
# =====================================================================
# SECRET_KEY=generate-a-strong-random-secret-key
# DEBUG=False
# ALLOWED_HOSTS=*
# CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app
# AIVEN_DB_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
